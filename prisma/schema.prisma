generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  mobile            String   @unique
  createdAt         DateTime @default(now())
  email             String?
  isProfileComplete Boolean  @default(false)
  name              String?

  likes         Like[]
  properties    Property[]
  subscriptions Subscription[]
  visits        Visit[]
}

model Subscription {
  id           Int      @id @default(autoincrement())
  userId       Int
  planType     String
  planDuration String
  amount       Int
  paymentId    String
  propertyType String
  startDate    DateTime
  expiryDate   DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Otp {
  id        Int      @id @default(autoincrement())
  mobile    String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Like {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, propertyId])
}

model Visit {
  id       Int    @id @default(autoincrement())
  date     String
  time     String
  status   String @default("pending")
  language String @default("en")

  userId     Int
  propertyId Int

  user     User     @relation(fields: [userId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
}
model Property {
  id     Int @id @default(autoincrement())
  userId Int

  // 📍 BASIC INFO
  city      String
  locality  String
  street    String?
  landmark  String?
  latitude  Float?
  longitude Float?

  // 🏠 PROPERTY INFO
  propertyName String?
  propertyType String   // PG / Hostel / Apartment
  gender       String?  // Boys / Girls / Co-living

  // 🛏 ROOM DETAILS (optional structure)
  roomType    Json?     // [{sharing, rent, deposit, amenities}]
  sharingType Json?     // optional
  noOfRooms   Int?
  noOfBeds    Int?

  // 💰 PRICING (optional overall)
  rent              Float?
  deposit           Float?
  depositNegotiable Boolean?
  rentNegotiable    Boolean?

  // 🍽 FACILITIES
  foodIncluded Boolean?
  foodType     Json?

  // 🔥 ALL AMENITIES (single source)
  pgAmenities Json?

  // 🚗 PARKING
  parking Boolean?

  // 🏢 RULES (clean JSON)
  restrictions Json?

  // 📝 DESCRIPTION
  propertyDescription String?

  // 👥 PREFERENCES
  preferredTenant Json?   // ["Boys", "Girls"]
  preferredGuests Json?   // ["Immediate", "Later"]

  // ⏰ AVAILABILITY
  availableFrom   DateTime?
  noticePeriod    Int?
  gateClosingTime DateTime?

  // 📸 MEDIA
  images String[] @default([])
  video  String?

  // 📞 CONTACT
  contactName     String?
  mobileNo        String?
  whatsapp        Boolean?
  whatsappupdates Boolean?

  // ⚙️ SYSTEM
  currentStep Int      @default(1)
  isDraft     Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔗 RELATIONS
  user   User    @relation(fields: [userId], references: [id])
  likes  Like[]
  visits Visit[]
}